PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-secret
CHANNEL3_API_KEY=your-channel3-key
GROQ_API_KEY=your-groq-key
# HF_TOKEN=your-huggingface-token (for faster downloads of LLM models, optional)
# GROQ_MODEL=gpt-oss-20b (optional: specify a different model for Groq inference)
# PAYPAL_VAULT_TOKEN=   (only for --auto; printed by: python -m scripts.vault_setup)
# AG_GRID_LICENSE_KEY=   (optional: your AG Grid / AG Studio license or trial key, see README)